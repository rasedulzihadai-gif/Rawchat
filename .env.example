# Postgres connection string for accounts, sessions & saved conversations.
# Login is required, so the app needs this to function fully.
# Example for local Postgres:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: guards GET /api/cron/cleanup (daily 7-day retention sweep).
# Generate one with: openssl rand -hex 32
# CRON_SECRET=change-me-to-a-long-random-string
